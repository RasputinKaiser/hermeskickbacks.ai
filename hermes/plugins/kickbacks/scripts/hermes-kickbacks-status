#!/usr/bin/env python3
"""
Kickbacks.ai — Terminal Status Line Display

Reads the ad cache written by the Hermes Kickbacks plugin and outputs
a clickable OSC 8 hyperlink suitable for terminal status bars (tmux,
iTerm2 status bar, WezTerm, etc.).

Usage:
  # One-shot: print current ad if fresh
  python3 hermes-kickbacks-status

  # Watch mode: loop every 2 seconds (for tmux status-right)
  python3 hermes-kickbacks-status --watch

Integration examples:

  tmux (in ~/.tmux.conf):
    set -g status-right "#(python3 ~/.hermes/plugins/kickbacks/scripts/hermes-kickbacks-status)"

  iTerm2 Status Bar:
    Add a "Shell Script" component pointing to this script

  fish prompt:
    function fish_prompt
      python3 ~/.hermes/plugins/kickbacks/scripts/hermes-kickbacks-status
      echo
      echo '$ '
    end

The output is a hyperlink: ad· Sponsor Text (clickable)
If no fresh ad is available, outputs nothing.
"""
from __future__ import annotations

import json
import sys
import time
from pathlib import Path

# ── Config ──────────────────────────────────────────────────────────────────

KICKBACKS_DIR = Path.home() / ".kickbacks"
AD_CACHE = KICKBACKS_DIR / "hermes-ad.json"
FRESH_MS = 10 * 60 * 1000  # Ad considered fresh for 10 minutes


def strip_controls(s: str) -> str:
    """Strip terminal control characters (C0 + DEL + C1)."""
    return "".join(c for c in s if ord(c) >= 32 or c in "\n\r\t")


def read_ad() -> dict | None:
    """Read the ad cache. Returns None if no valid/fresh ad."""
    try:
        if not AD_CACHE.exists():
            return None
        data = json.loads(AD_CACHE.read_text())
        if not isinstance(data.get("ad_text"), str) or not data["ad_text"]:
            return None
        # Check freshness
        ts = data.get("ts", 0)
        if isinstance(ts, (int, float)):
            age_ms = int(time.time() * 1000) - int(ts)
            if age_ms > FRESH_MS:
                return None
        return data
    except (json.JSONDecodeError, OSError, KeyError):
        return None


def format_ad(data: dict) -> str:
    """Format an ad as an OSC 8 clickable hyperlink."""
    text = strip_controls(data.get("ad_text", ""))
    url = strip_controls(data.get("click_url", ""))

    label = f"ad· {text}"

    if url:
        # OSC 8 hyperlink: ESC ]8;; URL ESC \ LABEL ESC ]8;; ESC \
        ESC = "\033"
        return f"{ESC}]8;;{url}{ESC}\\{label}{ESC}]8;;{ESC}\\"
    return label


def main() -> None:
    watch_mode = "--watch" in sys.argv or "-w" in sys.argv
    once_mode = "--once" in sys.argv or "-1" in sys.argv or not watch_mode

    if watch_mode:
        try:
            while True:
                ad = read_ad()
                if ad:
                    print(format_ad(ad), flush=True)
                time.sleep(2)
        except KeyboardInterrupt:
            pass
    else:
        ad = read_ad()
        if ad:
            print(format_ad(ad))


if __name__ == "__main__":
    main()
